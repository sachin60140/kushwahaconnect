APP_NAME=KushwahaConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://kushwahaconnect.com
APP_VERSION=1.0
APP_UPDATED_AT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.kushwahaconnect.com
MAIL_PORT=465
MAIL_USERNAME=no_reply@kushwahaconnect.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no_reply@kushwahaconnect.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=kushwahaconnect.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mobile OTP SMS. Use SMS_DRIVER=log locally (codes go to the log); smartping in production.
# Super admins can also set all of these in Admin -> SMS Settings, which takes precedence.
SMS_DRIVER=log
SMARTPING_USERNAME=
SMARTPING_PASSWORD=
# Optional overrides; leave commented to use the built-in defaults (config/services.php).
# SMARTPING_BASE_URL=
# SMARTPING_SENDER_ID=
# SMARTPING_DLT_CONTENT_ID=
# SMARTPING_DLT_PRINCIPAL_ID=
# DLT-registered template text, sent exactly as written; only {otp} is replaced.
# SMARTPING_OTP_MESSAGE=

VITE_APP_NAME="${APP_NAME}"
